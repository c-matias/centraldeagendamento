# Observabilidade — TUDO opcional. Cada fornecedor só liga se todas as suas chaves existirem.
# No Netlify: Site configuration → Environment variables. Estas chaves ficam visíveis no browser (são públicas por desenho).
VITE_APP_ENV=production

# Sentry (erros + performance)
VITE_SENTRY_DSN=

# Datadog RUM
VITE_DD_APPLICATION_ID=
VITE_DD_CLIENT_TOKEN=
VITE_DD_SITE=datadoghq.com

# New Relic Browser
VITE_NR_LICENSE_KEY=
VITE_NR_APPLICATION_ID=
VITE_NR_ACCOUNT_ID=
VITE_NR_TRUST_KEY=
VITE_NR_AGENT_ID=

# OpenTelemetry (endpoint OTLP/HTTP de um collector com CORS, ex.: https://otel.exemplo.com/v1/traces)
VITE_OTEL_EXPORTER_URL=

# ===== Galeria (Google Drive) — SÓ NO SERVIDOR (Netlify → Site configuration → Environment variables, scope "Functions") =====
# NÃO usar o prefixo VITE_ (ficaria visível no browser). Nunca pôr estas chaves no código nem em ficheiros commitados.
GOOGLE_DRIVE_API_KEY=
GOOGLE_DRIVE_FOLDER_ID=12zbmp1k38-RQZvwSzgCZT-GJDBFF-_pL
# opcionais
GALLERY_MAX_IMAGES=24
GALLERY_ORDER=name   # name (ordem natural dos nomes: 01-..., 02-...) | newest (mais recentes primeiro)
